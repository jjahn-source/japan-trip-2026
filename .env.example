# Firebase configuration — required for real-time crew collaboration
# Get this from Firebase Console > Project Settings > Your apps > Web app > SDK setup
# Paste the full config object as a JSON string (all on one line)
VITE_FIREBASE_CONFIG={"apiKey":"YOUR_KEY","authDomain":"YOUR_PROJECT.firebaseapp.com","projectId":"YOUR_PROJECT","storageBucket":"YOUR_PROJECT.firebasestorage.app","messagingSenderId":"000000000000","appId":"1:000000000000:web:abc123"}
