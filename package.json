{
  "name": "japan-trip-2026",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext ts,tsx",
    "format": "prettier --write src",
    "refresh-reddit": "node scripts/refresh-reddit.mjs && git add public/reddit-alerts.json && git diff --cached --quiet || git commit -m \"chore: refresh Reddit feed\" && git push",
    "refresh-all": "node scripts/refresh-reddit.mjs; node scripts/refresh-weather.mjs; node scripts/refresh-travel-intel.mjs; node scripts/refresh-briefing.mjs; node scripts/refresh-itinerary-optimizations.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@types/leaflet": "^1.9.21",
    "firebase": "^12.14.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.515.0",
    "motion": "^12.18.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.10",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^4.5.2",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "playwright": "^1.61.0",
    "prettier": "^3.0.0",
    "tailwindcss": "^4.1.10",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
