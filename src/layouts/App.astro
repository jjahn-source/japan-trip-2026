---
// Every page is the same app opened at a different view. The build renders that view with the real
// trip into #boot, so the page reads (and its links work) at first paint, even without JavaScript;
// the live app fetches the trip (precached for offline) and replaces #boot in the same frame.
import '../app/theme.css';
import App from '../app/App.svelte';
import { app, type View } from '../app/state.svelte';
import { appData } from '../app/build-data';
import { url } from '../lib/format';
import bodyFont from '../fonts/zen-kaku-400.woff2?url';
import displayFont from '../fonts/dela-gothic-one-400.woff2?url';

interface Props { title: string; view: View; description?: string }
const { title, view, description = 'The Japan trip for eight: every day hour by hour on a 3D map, with each train ride played out along its real route.' } = Astro.props;
app.data ??= appData();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0e112a" />
    <meta name="color-scheme" content="dark" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Japan" />
    <link rel="manifest" href={url('/manifest.webmanifest')} />
    <link rel="icon" href={url('/icon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={url('/icon-180.png')} />
    <!-- The trip data early on a first visit only: once the service worker has it, a preload made
         outside the worker can't be used and the 500 KB would come down twice. -->
    <script is:inline define:vars={{ dataUrl: url('/app-data.json') }}>
      if (!navigator.serviceWorker?.controller) {
        const l = document.createElement('link');
        l.rel = 'preload'; l.as = 'fetch'; l.crossOrigin = 'anonymous'; l.href = dataUrl;
        document.head.append(l);
      }
    </script>
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preconnect" href="https://api.mapbox.com" crossorigin />
    <slot name="head" />
  </head>
  <body>
    <div id="boot"><App initial={view} /></div>
    <App client:only="svelte" initial={view} />
    <script>
      if ('serviceWorker' in navigator && import.meta.env.PROD) {
        // A Home Screen app can stay open for days: look for a new version whenever it comes back to
        // the front, and once one has taken over, switch to it the next time it does (never mid-tap).
        const updating = !!navigator.serviceWorker.controller;
        navigator.serviceWorker.addEventListener('controllerchange', () => {
          if (!updating) return; // the first install, not an update
          document.addEventListener('visibilitychange', () => { if (document.visibilityState === 'visible') location.reload(); });
        });
        addEventListener('load', async () => {
          const reg = await navigator.serviceWorker.register(`${import.meta.env.BASE_URL}sw.js`);
          document.addEventListener('visibilitychange', () => { if (document.visibilityState === 'visible') reg.update().catch(() => {}); });
        });
      }
    </script>
  </body>
</html>
