---
import Shell from '../../layouts/Shell.astro';
import Stamp from '../../components/Stamp.astro';
import StationSign from '../../components/StationSign.astro';
import { trip, type DayX, type StopX } from '../../lib/trip';
import { icon } from '../../lib/icons';
import { directions, esc, inline, ja, price, tel, url } from '../../lib/format';
import { trending } from '../../lib/client';
import { existsSync, readFileSync } from 'node:fs';

export function getStaticPaths() {
  const t = trip();
  return t.days.map((day, i) => ({
    params: { n: String(day.n) },
    props: { day, prev: t.days[i - 1] ?? null, next: t.days[i + 1] ?? null },
  }));
}

interface Props { day: DayX; prev: DayX | null; next: DayX | null }
const { day, prev, next } = Astro.props;
const t = trip();
const trends = trending().days[String(day.n)] ?? [];
const TAG = { rising: 'Rising', december: 'Big in December', popular: 'Popular', pick: 'Researched' } as const;
// The lines this day rides (scripts/transit.mjs), in their own colours.
const transitFile = `${process.cwd()}/public/transit.json`;
const transitData = existsSync(transitFile) ? JSON.parse(readFileSync(transitFile, 'utf8')) as { days: Record<string, { label: string; colour: string; ids: string[] }[]> } : null;
const trains = transitData?.days[String(day.n)] ?? [];
// How each hop is travelled (scripts/legs.mjs): shown under the stop it leaves from.
const legsFile = `${process.cwd()}/public/legs.json`;
type LegSeg = { m: string; line?: string; colour?: string; on?: string; off?: string };
const legsData = existsSync(legsFile) ? JSON.parse(readFileSync(legsFile, 'utf8')) as { days: Record<string, { from: string; mode: string; minutes: number; km?: number; segs: LegSeg[] }[]> } : null;
const legFrom = new Map((legsData?.days[String(day.n)] ?? []).map((l) => [l.from, l]));
const LEG_ICON: Record<string, string> = { walk: 'footprints', rail: 'transport', ropeway: 'mountain', funicular: 'mountain', bus: 'transport', car: 'navigation', boat: 'navigation' };
// Typical weather (scripts/climate.mjs); the browser swaps in the real forecast 16 days out (japan.ts).
const climateFile = `${process.cwd()}/data/climate.json`;
const climate = existsSync(climateFile) ? (JSON.parse(readFileSync(climateFile, 'utf8')).days?.[String(day.n)] as { hi: number; lo: number; wet: number } | undefined) : undefined;
// Real timetable for the longer rides (scripts/timetable.mjs, NAVITIME), when a key was set at build.
const ttFile = `${process.cwd()}/public/timetable.json`;
type TT = { dep: string; arr: string; minutes: number; fare: number | null; transfers: number; rides: { line: string; colour: string | null; from: string; to: string; dep: string; arr: string }[] };
const timetable = existsSync(ttFile) ? (JSON.parse(readFileSync(ttFile, 'utf8')).legs ?? {}) as Record<string, TT> : {};
const hhmm = (iso: string) => iso.slice(11, 16);
const walk = (km: number) => Math.max(1, Math.round(((km * 1.3) / 4.5) * 60));

const briefing = day.notes.filter((n) => !n.check);
const checks = day.notes.filter((n) => n.check);
const KIND: Record<string, string> = { NOTE: '', 'BASE 1': 'Base 1', 'BASE 2': 'Base 2', 'BASE 3': 'Base 3', 'BASE 4': 'Base 4' };
const kindLabel = (k: string) => (k in KIND ? KIND[k] : k.charAt(0) + k.slice(1).toLowerCase());
const MARK: Record<string, string> = { confirmed: 'Confirmed', tobook: 'To book', unconfirmed: 'Not confirmed yet', tocheck: 'Check before' };
const stayFor = (s: StopX) => (s.category === 'stay' ? t.stays.find((x) => s.name.startsWith(x.short)) : undefined);

// The scrubber track is the day's real sky: night → sunrise → day → sunset → night.
let track = '';
if (day.sun && day.stops.length) {
  const lo = Date.parse(day.stops[0].startISO) - 30 * 60000;
  const hi = Math.max(Date.parse(day.stops.at(-1)!.endISO), day.sun.sunsetMs + 45 * 60000);
  const at = (x: number) => `${Math.max(0, Math.min(100, ((x - lo) / (hi - lo)) * 100)).toFixed(2)}%`;
  const m = 60000;
  track = [
    `#1d1846 ${at(day.sun.sunriseMs - 45 * m)}`, `#a46fb0 ${at(day.sun.sunriseMs - 12 * m)}`, `#ffb98c ${at(day.sun.sunriseMs + 8 * m)}`,
    `#9cbcf0 ${at(day.sun.sunriseMs + 70 * m)}`, `#9cbcf0 ${at(day.sun.sunsetMs - 80 * m)}`, `#ff9a5c ${at(day.sun.sunsetMs - 10 * m)}`,
    `#d2577a ${at(day.sun.sunsetMs + 10 * m)}`, `#3a2f8f ${at(day.sun.sunsetMs + 32 * m)}`, `#15132a ${at(day.sun.sunsetMs + 70 * m)}`,
  ].join(', ');
}
---
<Shell title={`Day ${day.n} · ${day.label} · ${day.title}`} description={day.title} view={{ kind: 'day', day: day.n }}>
  <header class="opener">
    <div class="opener-stamp">
      <Stamp n={day.n} kanji={day.stamp.kanji} place={day.stamp.place} date={day.date} weekday={day.weekday} variant="opener" />
    </div>
    <div>
      <p class="dayno"><span class="display">Day {day.n}</span><span class="date">{day.label}</span></p>
      <h1 set:html={ja(esc(day.title))} />
    </div>
  </header>
  <ul class="facts">
    {day.base && <li><Fragment set:html={icon('bed')} />{day.base.short}</li>}
    {day.sun && <li><Fragment set:html={icon('sunrise')} /><span class="time">{day.sun.sunrise}</span></li>}
    {day.sun && <li><Fragment set:html={icon('sunset')} /><span class="time">{day.sun.sunset}</span><span class="where">{day.sun.where}</span></li>}
    {day.stops.length > 0 && <li><Fragment set:html={icon('clock')} /><span class="time">{day.stops[0].start}–{day.stops.at(-1)!.end}</span></li>}
    {climate && <li data-weather data-kind="normal" title="Typical for this date, 2016–2025"><Fragment set:html={icon(climate.wet >= 35 ? 'cloudRain' : climate.lo <= 0 ? 'snowflake' : 'cloudSun')} /><span class="time">{climate.hi}° / {climate.lo}°</span><span class="where">typical · {climate.wet}% chance of rain</span></li>}
  </ul>
  <StationSign day={day} prev={prev} next={next} />

  {day.sun && day.stops.length > 0 && (
    <section class="scrubber" data-scrub-root aria-label="Play the day">
      <button class="play" type="button" data-play aria-pressed="false" aria-label="Play the day">
        <span class="i-play" set:html={icon('play')} />
        <span class="i-pause" set:html={icon('pause')} />
      </button>
      <div class="readout" aria-live="polite">
        <span class="clock time" data-clock>{day.stops[0].start}</span>
        <span class="phase" data-phase-label>Daylight</span>
        <span class="active" data-active-name>{day.stops[0].index + 1} · {day.stops[0].name}</span>
      </div>
      <div class="track" style={`--track: linear-gradient(90deg, ${track})`}>
        <input type="range" data-scrub aria-label={`Time of day, ${day.label}`} />
        <span class="tick" data-tick="rise" hidden><Fragment set:html={icon('sunrise')} />{day.sun.sunrise}</span>
        <span class="tick" data-tick="set" hidden><Fragment set:html={icon('sunset')} />{day.sun.sunset}</span>
      </div>
    </section>
  )}

  {briefing.length > 0 && (
    <section aria-labelledby="brief-h">
      <div class="section-head"><h2 id="brief-h">Briefing</h2></div>
      <div class="notes">
        {briefing.map((n) => (
          <p>{kindLabel(n.kind) && <strong class="kind">{kindLabel(n.kind)}{n.qualifier ? ` (${n.qualifier})` : ''}.</strong>} <Fragment set:html={inline(n.text)} /></p>
        ))}
      </div>
    </section>
  )}

  {checks.map((c, ci) => (
    <section aria-labelledby={`check-h-${ci}`}>
      <div class="section-head"><h2 id={`check-h-${ci}`}>Night-before check</h2>{c.qualifier && <span class="aside">{c.qualifier}</span>}</div>
      <ul class="checks">
        {c.text.split(' · ').map((item, i) => (
          <li><label><input type="checkbox" data-check={`d${day.n}-c${ci}-${i}`} /><span set:html={inline(item)} /></label></li>
        ))}
      </ul>
      <p class="hint">Ticks are saved on this phone only.</p>
    </section>
  ))}

  {trains.length > 0 && (
    <section class="trains" aria-labelledby="trains-h">
      <div class="section-head"><h2 id="trains-h">Trains in today's plan</h2><span class="aside">tap to see the line</span></div>
      <ul class="train-chips" role="list">
        {trains.map((l) => (
          <li><button type="button" class="train-chip" data-focus-line={l.ids.join(',')} style={`--line:${l.colour}`}>
            <span class="swatch" aria-hidden="true"></span><span class="tn">{l.label}</span>
          </button></li>
        ))}
      </ul>
    </section>
  )}

  {trends.length > 0 && (
    <section class="trending" aria-labelledby="tr-h">
      <div class="section-head"><h2 id="tr-h">Things to do nearby</h2><span class="aside">researched for your dates · trending on Wikipedia</span></div>
      <ul class="tcards" role="list">
        {trends.map((x) => (
          <li class="tcard" data-trend-card={x.id}>
            <button type="button" class="tcard-open" data-open-trend={x.id} data-day={day.n} aria-label={`Show ${x.name} on the map`}>
              {x.photo ? <img src={x.photo} alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" /> : <span class="glyph" lang="ja" aria-hidden="true">{(x.ja ?? x.name).slice(0, 1)}</span>}
              <span class="tag" data-tag={x.tag}>{x.tag === 'rising' && <Fragment set:html={icon('trendingUp')} />}{x.tag === 'december' && <Fragment set:html={icon('snowflake')} />}{x.tag === 'pick' && <Fragment set:html={icon('check')} />}{TAG[x.tag]}</span>
            </button>
            <p class="tname">{x.name}</p>
            {x.when && <p class="twhen">{x.when}</p>}
            <p class="twalk"><Fragment set:html={icon('footprints')} />{walk(x.near.km)} min from stop {x.near.i}</p>
            <button type="button" class="tadd" data-trend-toggle={x.id} data-day={day.n} aria-pressed="false"><span class="off"><Fragment set:html={icon('plus')} />Add</span><span class="on"><Fragment set:html={icon('check')} />Added</span></button>
          </li>
        ))}
      </ul>
      <p class="tfoot"><button type="button" class="chip" data-share-adds hidden><Fragment set:html={icon('share')} /><span data-adds-count>Share adds</span></button> Adds are saved on this phone and slot in after the nearest stop.</p>
    </section>
  )}

  <section aria-labelledby="tt-h">
    <div class="section-head"><h2 id="tt-h">Timetable</h2><span class="aside">{day.stops.length ? `${day.stops.length} stops · Japan time` : 'travel day'}</span></div>
    {day.stops.length === 0 ? (
      <p class="empty">No scheduled stops. Fly to Japan; the stamp card starts at Haneda tomorrow, Tue Dec 15, 15:00.</p>
    ) : (
      <ol class="timetable">
        {day.stops.map((s) => {
          const pr = price(s.price);
          const stay = stayFor(s);
          const nextDay = s.startISO.slice(0, 10) !== day.date;
          return (
            <li class="stop" id={s.id} data-stop={s.id} data-state="ahead">
              <div class="rail-col" aria-hidden="true"><button type="button" class="dot" data-focus-stop={s.id} tabindex="-1">{s.index + 1}</button></div>
              <p class="when"><span class="start time">{s.start}</span><span class="end time">–{s.end}</span>{nextDay && <span class="after">after midnight</span>}</p>
              <div class="what">
                <span class="now-flag" aria-hidden="true">Now</span>
                <h3 set:html={ja(esc(s.name))} />
                <p class="meta">
                  <span class="cat"><Fragment set:html={icon(s.category)} />{s.categoryLabel}</span>
                  {pr ? <span class="price"><span class="time">{pr.amount}</span> {pr.unit === 'group' ? 'group total' : 'pp'}</span> : <span class="price">Free</span>}
                  {s.mark && (
                    <a class="mark" data-mark={s.mark} data-todo-mark={s.mark === 'tobook' ? s.todoId : undefined}
                       href={s.todoId ? url(`/bookings/#${s.todoId}`) : undefined}><span data-mark-label>{MARK[s.mark]}</span></a>
                  )}
                </p>
                {s.plan && <p class="plan" set:html={inline(s.plan)} />}
                {s.guide && (() => {
                  const g = s.guide;
                  const photo = g.media.find((m) => m.kind === 'image');
                  const videos = g.media.filter((m) => m.kind !== 'image' && m.embed);
                  return (
                    <div class="guide">
                      {photo && (
                        <figure class="g-photo"><img src={photo.url} alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" onerror="this.closest('figure').remove()" />{photo.credit && <figcaption>{photo.credit}</figcaption>}</figure>
                      )}
                      <p class="g-story">{g.story}</p>
                      {g.how.length > 0 && (<Fragment><h4>How to do it</h4><ol class="g-how">{g.how.map((x) => <li set:html={inline(x)} />)}</ol></Fragment>)}
                      {g.tips.length > 0 && (<Fragment><h4>Tips</h4><ul class="g-tips">{g.tips.map((x) => <li set:html={inline(x)} />)}</ul></Fragment>)}
                      {(g.cost || g.booking || g.hours) && (
                        <dl class="g-facts">
                          {g.cost && <div><dt>Cost</dt><dd>{g.cost}</dd></div>}
                          {g.booking && <div><dt>Booking</dt><dd>{g.booking}</dd></div>}
                          {g.hours && <div><dt>Hours</dt><dd>{g.hours}</dd></div>}
                        </dl>
                      )}
                      {videos.length > 0 && (
                        <div class="g-videos">
                          {videos.map((v) => (
                            <button type="button" class="g-video" data-embed={v.embed} data-kind={v.kind} aria-label={`Play ${v.kind === 'youtube' ? 'YouTube' : v.kind === 'tiktok' ? 'TikTok' : 'Instagram'} video${v.credit ? ` by ${v.credit}` : ''}`}>
                              {v.thumb && <img src={v.thumb} alt="" loading="lazy" referrerpolicy="no-referrer" />}
                              <span class="g-play"><Fragment set:html={icon('play')} /></span>
                              <span class="g-vlabel">{v.kind === 'youtube' ? 'YouTube' : v.kind === 'tiktok' ? 'TikTok' : 'Reel'}{v.credit ? ` · ${v.credit}` : ''}</span>
                            </button>
                          ))}
                        </div>
                      )}
                      {g.sources.length > 0 && (
                        <p class="g-src">Found in: {g.sources.map((x, k) => <Fragment>{k > 0 && ' · '}<a href={x.url} target="_blank" rel="noopener">{x.label}</a></Fragment>)}</p>
                      )}
                      {g.wishes.length > 0 && <p class="g-wish">Because you asked: {g.wishes.join(' · ')}</p>}
                      {g.facts && g.facts.length > 0 && (
                        <details class="g-checked"><summary>Checked facts ({g.facts.length})</summary>
                          <ul class="g-facts" aria-label="Verified facts">{g.facts.map((f) => <li>{f.text} · <a href={f.url} target="_blank" rel="noopener">{(() => { try { return new URL(f.url).hostname.replace(/^www\./, ''); } catch { return 'source'; } })()}</a></li>)}</ul>
                        </details>
                      )}
                      {g.verified && <p class="g-ver">{g.verified.status === 'OPERATIONAL' ? 'Checked open' : 'Checked'} on {g.verified.source}</p>}
                    </div>
                  );
                })()}
                {stay && (
                  <p class="stay"><span class="mark" data-mark="confirmed">Confirmation</span> <code>{stay.confirmation}</code>
                    <button class="copy" type="button" data-copy={stay.confirmation} aria-label={`Copy confirmation ${stay.confirmation}`}><Fragment set:html={icon('copy')} /><Fragment set:html={icon('check')} /></button></p>
                )}
                <div class="actions">
                  {s.lat != null && <button class="chip primary" type="button" data-focus-stop={s.id}><Fragment set:html={icon('map')} />On the map</button>}
                  {s.lat != null && <a class="chip" href={directions(s.lat, s.lng!)} target="_blank" rel="noopener"><Fragment set:html={icon('navigation')} />Directions</a>}
                  {s.website && !/google\.com\/maps/.test(s.website) && <a class="chip" href={s.website} target="_blank" rel="noopener"><Fragment set:html={icon('globe')} />Website</a>}
                  {s.phone && <a class="chip" href={tel(s.phone)}><Fragment set:html={icon('phone')} />Call</a>}
                </div>
                {(s.summary || s.details.length > 0 || s.extra.length > 0 || s.address) && (
                  <details class="more">
                    <summary><Fragment set:html={icon('next')} />Hours, tips and address</summary>
                    <div class="more-body">
                      {s.summary && <p set:html={inline(s.summary)} />}
                      {s.details.length > 0 && (
                        <dl>
                          {s.details.map((d) => d.label
                            ? <div class="row"><dt set:html={ja(esc(d.label))} /><dd set:html={inline(d.text)} /></div>
                            : <div class="row solo"><dd set:html={inline(d.text)} /></div>)}
                        </dl>
                      )}
                      {s.extra.map((e) => <p set:html={inline(e)} />)}
                      {s.address && (
                        <p class="addr"><span set:html={ja(esc(s.address))} />
                          <button class="copy" type="button" data-copy={s.address} aria-label="Copy address"><Fragment set:html={icon('copy')} /><Fragment set:html={icon('check')} /></button></p>
                      )}
                      {s.phone && <p class="phone">Phone <a href={tel(s.phone)}>{s.phone}</a></p>}
                    </div>
                  </details>
                )}
                {legFrom.get(s.id) && (() => {
                  const l = legFrom.get(s.id)!;
                  const rides = l.segs.filter((x) => x.line);
                  return (
                    <p class="leg" data-mode={l.mode}>
                      <Fragment set:html={icon((LEG_ICON[l.mode] ?? 'navigation') as never)} />
                      {rides.length > 0
                        ? <span>{rides.map((r, k) => <Fragment>{k > 0 && ' → '}<span class="ride" style={`--line:${r.colour}`}>{r.line}</span>{r.on && r.off && <span class="stn"> {r.on}–{r.off}</span>}</Fragment>)}</span>
                        : <span>{l.mode === 'walk' ? 'Walk' : l.mode === 'boat' ? 'Boat' : l.mode === 'bus' ? 'Bus' : 'By car'}</span>}
                      <span class="mins">~{l.minutes} min</span>
                      {timetable[s.id] && (() => {
                        const tt = timetable[s.id];
                        return (
                          <span class="tt">
                            <span class="tt-head"><Fragment set:html={icon('clock3')} />Timetable: dep <b class="time">{hhmm(tt.dep)}</b> → arr <b class="time">{hhmm(tt.arr)}</b> · {tt.minutes} min{tt.transfers ? ` · ${tt.transfers} change${tt.transfers > 1 ? 's' : ''}` : ''}{tt.fare ? <Fragment> · <span data-yen>¥{tt.fare.toLocaleString('en-US')}</span></Fragment> : ''}</span>
                            {tt.rides.map((r) => <span class="tt-ride" style={`--line:${r.colour ?? 'var(--print)'}`}><b class="time">{hhmm(r.dep)}</b> {r.line} · {r.from} → {r.to} <b class="time">{hhmm(r.arr)}</b></span>)}
                          </span>
                        );
                      })()}
                      {(l.km ?? 0) >= 3 && l.mode !== 'walk' && (
                        <span class="live" data-live={s.id}>
                          <button type="button" class="chip" data-live-btn={s.id}><Fragment set:html={icon('radio')} />Live times</button>
                          <span class="live-out" data-live-out aria-live="polite"></span>
                        </span>
                      )}
                    </p>
                  );
                })()}
              </div>
            </li>
          );
        })}
      </ol>
    )}
    {/* Cloned by app.ts for each quick add, so it carries this page's scoped styles. */}
    <template data-add-row>
      <li class="stop added-stop" data-state="ahead">
        <div class="rail-col" aria-hidden="true"><button type="button" class="dot" tabindex="-1" data-add-focus><Fragment set:html={icon('plus')} /></button></div>
        <p class="when"><span class="added-label">Your add</span></p>
        <div class="what">
          <h3 data-add-name></h3>
          <p class="meta"><span class="cat" data-add-walk></span></p>
          <div class="actions">
            <button class="chip primary" type="button" data-add-focus><Fragment set:html={icon('map')} />On the map</button>
            <a class="chip" data-add-dir target="_blank" rel="noopener"><Fragment set:html={icon('navigation')} />Directions</a>
            <button class="chip" type="button" data-add-remove><Fragment set:html={icon('x')} />Remove</button>
          </div>
        </div>
      </li>
    </template>
    <p class="hint">{legsData ? 'Routes follow the real train lines and streets, from the plan\'s own notes; times are estimates. Use Directions for live times.' : 'Map lines join stops in order; they are not walking or train routes. Use Directions for the real route.'}</p>
  </section>

  <div class="end-sign"><StationSign day={day} prev={prev} next={next} /></div>
</Shell>

<script>
  // Social videos load only when tapped: no third-party scripts or tracking until then.
  document.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-embed]');
    if (!b) return;
    const f = document.createElement('iframe');
    f.src = b.dataset.embed!;
    f.className = 'g-frame';
    f.dataset.kind = b.dataset.kind;
    f.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
    f.setAttribute('allowfullscreen', '');
    f.title = b.getAttribute('aria-label') ?? 'Video';
    b.replaceWith(f);
  });
</script>

<style>
  /* The guidebook spread: everything visible, written to be read on the train. */
  .guide { display: grid; gap: 0.55rem; margin-top: 0.7rem; }
  .guide h4 { font-family: var(--f-display); font-stretch: 106%; font-weight: 750; font-size: 0.78rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--print); margin-top: 0.2rem; }
  .g-photo { margin: 0; border-radius: 12px; overflow: hidden; background: var(--print-wash); }
  .g-photo img { display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: cover; }
  .g-photo figcaption { font-size: 0.72rem; color: var(--text-2); padding: 0.3rem 0.55rem; }
  .g-story { font-size: 0.97rem; line-height: 1.55; }
  .g-how, .g-tips { padding-left: 1.2rem; display: grid; gap: 0.3rem; font-size: 0.93rem; line-height: 1.45; }
  .g-tips { list-style: '→ '; }
  .g-facts { display: grid; gap: 0.35rem; padding: 0.55rem 0.7rem; border-radius: 10px; background: var(--paper-2); border: 1.5px solid var(--print-line); font-size: 0.88rem; }
  .g-facts div { display: grid; grid-template-columns: 4.6rem 1fr; gap: 0.5rem; }
  .g-facts dt { font-weight: 750; color: var(--print); }
  .g-facts dd { margin: 0; }
  .g-videos { display: flex; gap: 0.5rem; overflow-x: auto; scrollbar-width: none; }
  .g-video { position: relative; flex: none; width: 132px; aspect-ratio: 9 / 16; border: 0; padding: 0; border-radius: 12px; overflow: hidden; cursor: pointer; background: linear-gradient(160deg, var(--print), var(--print-2)); color: #fff; }
  .g-video[data-kind='youtube'] { width: 220px; aspect-ratio: 16 / 9; }
  .g-video img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .g-play { position: absolute; inset: 0; display: grid; place-items: center; }
