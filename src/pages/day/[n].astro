---
import Layout from '../../layouts/App.astro';
import { trip, type DayX } from '../../lib/trip';

export function getStaticPaths() {
  return trip().days.map((day) => ({ params: { n: String(day.n) }, props: { day } }));
}
const { day } = Astro.props as { day: DayX };
---
<Layout title={`Day ${day.n} · ${day.label} · ${day.title}`} description={`Day ${day.n} of the Japan trip, ${day.label}: ${day.title}.`} view={{ kind: 'day', n: day.n }} />
