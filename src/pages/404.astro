---
// A link that isn't part of the trip (a mistyped day, an old shared link): say so, in the trip's own
// night, and offer the way back. Cloudflare serves it for any unknown path (wrangler.jsonc).
import '../app/theme.css';
import { url } from '../lib/format';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Not in the trip · Japan</title>
    <meta name="theme-color" content="#0e112a" />
    <meta name="color-scheme" content="dark" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href={url('/icon.svg')} type="image/svg+xml" />
  </head>
  <body>
    <main class="nf">
      <p class="mark display" aria-hidden="true">迷子</p>
      <h1>That page isn't part of the trip</h1>
      <p class="sub">The link may be mistyped, or from an older version of the plan.</p>
      <nav class="go" aria-label="Back to the trip">
        <a class="primary" href={url('/')}>Trip overview</a>
        <a href={url('/today/')}>Today</a>
        <a href={url('/bookings/')}>Bookings</a>
      </nav>
    </main>
  </body>
</html>

<style>
  body { min-height: 100svh; margin: 0; background: var(--night); color: var(--washi); }
  .nf { min-height: 100svh; display: grid; align-content: center; justify-items: start; gap: 12px; max-width: 34rem; padding: 32px max(24px, env(safe-area-inset-right, 0px)) 48px max(24px, env(safe-area-inset-left, 0px)); margin: 0 auto; }
  .mark { font-size: clamp(3.4rem, 18vw, 5rem); line-height: 1; color: var(--lantern); text-shadow: 0 0 34px oklch(83% 0.145 76 / 0.35); }
  h1 { font-size: 1.35rem; font-weight: 700; line-height: 1.3; }
  .sub { color: var(--washi-2); font-size: 0.95rem; }
  .go { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 10px; }
  .go a { display: inline-flex; align-items: center; min-height: 44px; padding: 0 18px; border-radius: 99px; border: 1px solid var(--rule-strong); color: var(--washi); text-decoration: none; font-weight: 700; }
  .go a.primary { background: var(--lantern); border-color: var(--lantern); color: oklch(20% 0.05 276); }
  .go a:focus-visible { outline: 2px solid var(--lantern); outline-offset: 2px; }
</style>
