---
import Shell from '../layouts/Shell.astro';
import { trip } from '../lib/trip';
import { esc, inline, ja, linkify, url } from '../lib/format';

const t = trip();
const dated = t.todos.filter((x) => x.due).sort((a, b) => a.due!.localeCompare(b.due!));
const undated = t.todos.filter((x) => !x.due);
const months = [...new Set(dated.map((x) => x.due!.slice(0, 7)))];
const monthName = (ym: string) => new Date(`${ym}-01T00:00:00Z`).toLocaleString('en', { month: 'long', timeZone: 'UTC' });
const stopsOf = (ids: string[]) => t.days.flatMap((d) => d.stops).filter((s) => ids.includes(s.id));
const KIND = { book: 'Book', check: 'Check', task: 'Task' } as const;
---
<Shell title="Bookings · Japan Plan C" active="bookings" view={{ kind: 'bookings' }}>
  <header class="mast">
    <div class="wrap">
      <h1 class="display">Bookings</h1>
      <p class="meta">{dated.length} dated bookings and checks, {undated.length} anytime tasks. Tick one when it’s done; ticks are saved on this phone and update the marks on every day page.</p>
      <p class="legend">On the map: <span class="mark" data-mark="tobook">to book</span> <span class="mark" data-mark="tocheck">to check</span> <span>D7 = Day 7, ×3 = three here (tap to zoom in)</span></p>
    </div>
  </header>

  <div class="wrap" id="overdue">
    <section aria-labelledby="stays-h">
      <div class="section-head"><h2 id="stays-h">Confirmed</h2><span class="aside">{t.stays.length} stays</span></div>
      <ul class="stays">
        {t.stays.map((s) => (
          <li>
            <span class="mark" data-mark="confirmed">{s.short}</span>
            <span class="time">{s.checkIn} → {s.checkOut}</span>
            <code>{s.confirmation}</code>
          </li>
        ))}
      </ul>
    </section>

    {months.map((m) => (
      <section aria-labelledby={`m-${m}`}>
        <div class="section-head"><h2 id={`m-${m}`}>{monthName(m)}</h2></div>
        <ol class="todos">
          {dated.filter((x) => x.due!.startsWith(m)).map((x) => (
            <li class="todo" id={x.id} data-todo-item={x.id} data-kind={x.kind}>
              <input type="checkbox" id={`cb-${x.id}`} data-todo={x.id} aria-describedby={`d-${x.id}`} />
              <div class="body">
                <p class="top">
                  <span class="due time">{x.dueLabel}</span>
                  <span class="kind">{KIND[x.kind]}</span>
                  <span class="state" data-due={x.due}></span>
                </p>
                <label for={`cb-${x.id}`} class="text" set:html={ja(esc(x.text))} />
                {x.detail && <p class="detail" id={`d-${x.id}`} set:html={x.detail.split('\n').map((l) => inline(linkify(l))).join('<br>')} />}
                {x.stops.length > 0 && (
                  <p class="links">
                    {stopsOf(x.stops).map((s) => <a href={url(`/day/${s.day}/#${s.id}`)}>Day {s.day} · {s.start} · {s.name.split(' — ')[0]}</a>)}
                  </p>
                )}
              </div>
            </li>
          ))}
        </ol>
      </section>
    ))}

    <section aria-labelledby="any-h">
      <div class="section-head"><h2 id="any-h">Anytime</h2></div>
      <ol class="todos">
        {undated.map((x) => (
          <li class="todo" id={x.id} data-todo-item={x.id} data-kind={x.kind}>
            <input type="checkbox" id={`cb-${x.id}`} data-todo={x.id} />
            <div class="body">
              <label for={`cb-${x.id}`} class="text" set:html={ja(esc(x.text))} />
              {x.detail && <p class="detail" set:html={inline(linkify(x.detail))} />}
            </div>
          </li>
        ))}
      </ol>
    </section>
    <p class="foot">Dates are the last day to act, from the TREK booking schedule. A booking counts as done only when you tick it here; the plan’s “Booked” notes describe the target, not a confirmation.</p>
  </div>
</Shell>

<style>
  .mast { margin-top: 1rem; }
  h1 { font-size: 1.6rem; line-height: 1; color: var(--print); }
  .meta { margin-top: 0.5rem; color: var(--text-2); font-size: 0.92rem; }
  .legend { margin-top: 0.5rem; color: var(--text-2); font-size: 0.8125rem; display: flex; flex-wrap: wrap; align-items: center; gap: 0.3rem 0.6rem; }
  .stays { list-style: none; padding: 0; display: grid; gap: 0.4rem; }
  .stays li { display: flex; flex-wrap: wrap; gap: 0.3rem 1rem; align-items: baseline; padding: 0.55rem 0; border-bottom: 1px solid var(--print-line); }
  .stays .time { color: var(--text-2); font-size: 0.9rem; }
  code { font-family: var(--f-display); font-stretch: 106%; font-weight: 700; letter-spacing: 0.06em; margin-left: auto; }
  .todos { list-style: none; padding: 0; }
  .todo { display: grid; grid-template-columns: 28px 1fr; gap: 0.8rem; padding: 1rem 0; border-bottom: 1px solid var(--print-line); scroll-margin-top: 4rem; }
  .todo:target { background: var(--verm-wash); box-shadow: -0.6rem 0 0 var(--verm-wash), 0.6rem 0 0 var(--verm-wash); }
  .todo input { width: 24px; height: 24px; margin-top: 0.2rem; }
  .top { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.25rem 0.8rem; }
  .due { color: var(--print); }
  .kind { font-size: 0.75rem; font-weight: 750; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-2); }
  .state { font-size: 0.8125rem; font-weight: 650; color: var(--text-2); display: inline-flex; align-items: center; gap: 0.4em; }
  .state::before { content: ''; width: 0.75em; height: 0.75em; border-radius: 50%; border: 2px solid var(--print-line); flex: none; }
  .state[data-state='overdue'] { color: var(--text); }
  .state[data-state='overdue']::before { border-color: var(--verm); }
  .state[data-state='soon']::before { border-color: var(--print); }
  .state[data-state='done']::before { border-color: var(--print); background: var(--print); }
  .text { display: block; margin-top: 0.25rem; font-weight: 650; cursor: pointer; }
  .todo[data-state='done'] .text { color: var(--text-2); text-decoration: line-through; text-decoration-color: var(--verm); }
  .detail { margin-top: 0.4rem; color: var(--text-2); font-size: 0.95rem; max-width: var(--measure); overflow-wrap: anywhere; }
  .detail :global(a) { color: var(--print); }
  .links { display: flex; flex-wrap: wrap; gap: 0.3rem 1rem; margin-top: 0.5rem; font-size: 0.875rem; }
  .links a { color: var(--print); font-weight: 600; }
  .foot { margin: 3rem 0 2.5rem; color: var(--text-2); font-size: 0.875rem; max-width: var(--measure); }
</style>
