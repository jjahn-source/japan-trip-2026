---
import Shell from '../layouts/Shell.astro';
import { trip } from '../lib/trip';
import { inline, url } from '../lib/format';

const t = trip();
const essentials = t.days[0].notes;
const TITLE: Record<string, string> = { BOOKINGS: 'Bookings', MONEY: 'Money', 'PHONES & TRANSIT': 'Phones & transit', 'GROUP RULES': 'Group rules' };

// Every phrase below appears in the plan; the meaning is the plan's own gloss.
const phrases = [
  { ja: '8名で、同じテーブル/個室', en: '8 people, same table / private room', when: 'Any booking or walk-in', href: '/info/#group-rules' },
  { ja: '8名です。全員同じテーブル（できれば個室）でお願いします。日本語が少しだけ話せます。', en: '8 people, all at one table (private room if possible); we speak a little Japanese', when: 'Request box on Japanese booking sites', href: '/bookings/#todo-01' },
  { ja: '8人入れますか？', en: 'Can 8 of us come in?', when: 'Golden Gai bars, Day 5', href: '/day/5/#d05-s10' },
  { ja: 'フリータイム', en: 'free time: one flat karaoke rate', when: 'Manekineko, Days 3 and 13', href: '/day/3/#d03-s16' },
  { ja: '持ち込み', en: 'bringing your own food and drinks', when: 'Karaoke rooms', href: '/day/3/#d03-s16' },
  { ja: '半個室', en: 'semi-private room (7–10)', when: 'Uoshin, Day 3', href: '/day/3/#d03-s15' },
  { ja: '個室', en: 'private room', when: 'Chanko Kirishima, Day 4', href: '/day/4/#d04-s04' },
  { ja: '半額', en: 'half-price sticker on bentō after ~19:00', when: 'Supermarkets', href: '/day/2/#d02-s03' },
  { ja: 'コンビニ支払い', en: 'pay at a convenience store', when: 'B.LEAGUE tickets', href: '/bookings/#todo-13' },
  { ja: '稽古', en: 'practice (check the sumo stable calendar)', when: 'Arashio-beya, Day 4', href: '/day/4/#d04-s01' },
];

const previews = [
  { label: 'Day 3, 18:00', note: 'Shibuya after sunset', now: '2026-12-16T18:00' },
  { label: 'Day 7, 16:30', note: 'sunset at the Yunessun baths', now: '2026-12-20T16:30' },
  { label: 'Day 11, 20:00', note: 'Christmas Eve at USJ', now: '2026-12-24T20:00' },
  { label: 'Day 13, 02:00', note: 'karaoke till first train', now: '2026-12-27T02:00' },
];
---
<Shell title="Info · Japan Plan C" active="info" view={{ kind: 'plain' }}>
  <header class="mast">
    <div class="wrap">
      <h1 class="display">Info</h1>
      <p class="meta">The rules of the road for all sixteen days, the Japanese you’ll actually use, and how to keep this site on your phone.</p>
    </div>
  </header>

  <div class="wrap read">
    {essentials.map((n) => (
      <section id={n.kind.toLowerCase().replace(/[^a-z]+/g, '-')} aria-labelledby={`h-${n.kind}`}>
        <div class="section-head"><h2 id={`h-${n.kind}`}>{TITLE[n.kind] ?? n.kind}</h2></div>
        <ul class="points">
          {n.text.split(/(?<=\.)\s+(?=[A-Z])/).map((s) => <li set:html={inline(s)} />)}
        </ul>
      </section>
    ))}

    <section aria-labelledby="fx-h">
      <div class="section-head"><h2 id="fx-h">Yen to dollars</h2><span class="aside" data-fx-rate hidden></span></div>
      <label class="fx"><span>¥</span><input type="text" inputmode="numeric" data-fx-input value="1000" aria-label="Amount in yen" /><output data-fx-out></output></label>
      <p class="note">Prices on the day pages show ≈ $ at today's rate too.</p>
    </section>

    <section aria-labelledby="live-h">
      <div class="section-head"><h2 id="live-h">Live on the trip</h2></div>
      <ul class="points">
        <li><strong>Search</strong> (top of the map): places, food and stations, the same index TREK uses; the chips find konbini, ATMs (Seven Bank takes foreign cards), coin lockers and toilets around wherever the map is.</li>
        <li><strong>Weather</strong>: each day shows the typical weather for that date, then the real forecast from 16 days out.</li>
        <li><strong>Alerts</strong>: during the trip, weather warnings from the Japan Meteorological Agency and any felt earthquake or tsunami advisory appear at the top of the panel.</li>
        <li><strong>Live times</strong>: longer rides have a button for the next departures (Google Maps transit, which has live times in Japan).</li>
      </ul>
    </section>

    <section aria-labelledby="ph-h">
      <div class="section-head"><h2 id="ph-h">Phrases from the plan</h2></div>
      <dl class="phrases">
        {phrases.map((p) => (
          <div class="phrase">
            <dt lang="ja">{p.ja}</dt>
            <dd><span class="en">{p.en}</span> <a href={url(p.href)}>{p.when}</a></dd>
          </div>
        ))}
      </dl>
    </section>

    <section aria-labelledby="pv-h">
      <div class="section-head"><h2 id="pv-h">See any moment of the trip</h2></div>
      <p>The site follows the clock in Japan: the card stamps itself day by day, and the home page shows what’s on now and next. To preview a moment before you fly, open one of these:</p>
      <ul class="previews">
        {previews.map((p) => <li><a class="chip" href={`${url('/')}?now=${p.now}`}>{p.label}</a> <span>{p.note}</span></li>)}
      </ul>
      <p>Each day page also has <strong>Play the day</strong>: the map flies stop to stop while the light follows the real sun over that place, from sunrise through golden hour to night.</p>
    </section>

    <section aria-labelledby="inst-h">
      <div class="section-head"><h2 id="inst-h">On your phone</h2></div>
      <ul class="points">
        <li><strong>iPhone:</strong> open the site in Safari, tap Share, then <em>Add to Home Screen</em>. It opens full-screen like an app.</li>
        <li><strong>Offline:</strong> after one visit with signal, every page, time, address and booking code works without a connection. Map tiles you’ve already looked at are kept too.</li>
        <li><strong>Ticks</strong> on bookings and night-before checks are saved on each phone separately.</li>
      </ul>
    </section>

    <p class="foot">Maps: <a href="https://openfreemap.org">OpenFreeMap</a> · © <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors · terrain <a href="https://mapterhorn.com/attribution">© Mapterhorn</a>. Sunrise and sunset are computed for each day’s location (NOAA method, ±1 min).</p>
  </div>
</Shell>

<style>
  .mast { margin-top: 1rem; }
  h1 { font-size: 1.6rem; line-height: 1; color: var(--print); }
  .meta { margin-top: 0.5rem; color: var(--text-2); font-size: 0.92rem; }
  .read > section, .read > p { max-width: var(--measure); }
  .points { padding-left: 1.1rem; display: grid; gap: 0.55rem; }
  .points li::marker { color: var(--print); }
  .phrases { display: grid; gap: 0; border-top: 1.5px solid var(--print-line); }
  .phrase { display: grid; gap: 0.2rem; padding: 0.85rem 0; border-bottom: 1px solid var(--print-line); }
  .phrase dt { font-family: var(--f-ja); font-weight: 700; font-size: 1.25rem; color: var(--print); line-height: 1.4; }
  .phrase dd { margin: 0; color: var(--text-2); }
  .phrase .en { color: var(--text); }
  .phrase a { font-size: 0.875rem; color: var(--print); white-space: nowrap; }
  .fx { display: flex; align-items: center; gap: 0.6rem; font-size: 1.25rem; font-weight: 700; color: var(--print); }
  .fx input { width: 9rem; font: inherit; color: var(--text); padding: 0.4rem 0.6rem; border-radius: 10px; border: 1.5px solid var(--print-line); background: var(--paper); }
  .fx output { color: var(--text); }
  .note { margin-top: 0.5rem; font-size: 0.875rem; color: var(--text-2); }
  .previews { list-style: none; padding: 0; display: grid; gap: 0.5rem; margin: 1rem 0; }
  .previews li { display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; }
  .previews span { color: var(--text-2); }
  section p + p, section p + ul, section ul + p { margin-top: 0.75rem; }
  .foot { margin: 3rem 0 2.5rem; color: var(--text-2); font-size: 0.875rem; }
  .foot a { color: inherit; }
</style>
