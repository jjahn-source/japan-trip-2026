---
// The home-screen shortcut: opens today's day during the trip (the night counts until 5am), else the trip.
import Layout from '../layouts/App.astro';
import { trip } from '../lib/trip';
import { url } from '../lib/format';
const t = trip();
const days = Object.fromEntries(t.days.map((d) => [d.date, d.n]));
const dayBase = url('/day/');
---
<Layout title={`Today · ${t.title}`} view={{ kind: 'trip' }}>
  <script slot="head" is:inline define:vars={{ days, dayBase }}>
    const n = days[new Date(Date.now() + 4 * 3600e3).toISOString().slice(0, 10)];
    if (n) location.replace(`${dayBase}${n}/${location.search}`);
  </script>
</Layout>
