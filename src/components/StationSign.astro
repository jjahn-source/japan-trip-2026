---
// Day-to-day wayfinding drawn like a JR station name board (駅名標):
// the current day large in the centre, the previous and next days at either side.
import type { DayX } from '../lib/trip';
import { icon } from '../lib/icons';
import { url } from '../lib/format';

interface Props { day: DayX; prev: DayX | null; next: DayX | null }
const { day, prev, next } = Astro.props;
const place = (d: DayX) => d.stamp.place.split(' · ')[0].toLowerCase().replace(/(^|\s)\S/g, (c) => c.toUpperCase());
---
<nav class="sign" aria-label="Previous and next day">
  {prev ? (
    <a class="side prev" href={url(`/day/${prev.n}/`)} rel="prev">
      <Fragment set:html={icon('prev')} />
      <span class="k" lang="ja">{prev.stamp.kanji}</span>
      <span class="t"><span class="num">Day {prev.n}</span><span class="pl">{place(prev)}</span></span>
    </a>
  ) : <span class="side prev empty" />}
  <span class="here" aria-current="page">
    <span class="k" lang="ja">{day.stamp.kanji}</span>
    <span class="num">D{String(day.n).padStart(2, '0')}</span>
  </span>
  {next ? (
    <a class="side next" href={url(`/day/${next.n}/`)} rel="next">
      <span class="t"><span class="num">Day {next.n}</span><span class="pl">{place(next)}</span></span>
      <span class="k" lang="ja">{next.stamp.kanji}</span>
      <Fragment set:html={icon('next')} />
    </a>
  ) : <span class="side next empty" />}
</nav>

<style>
  .sign {
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: stretch;
    background: var(--paper); color: var(--text);
    border-radius: 10px; overflow: hidden;
    box-shadow: 0 1px 2px oklch(0% 0 0 / 0.14), 0 10px 24px -12px oklch(0% 0 0 / 0.4);
    position: relative; padding-bottom: 6px;
  }
  /* The line-colour band under every station sign. */
  .sign::after { content: ''; position: absolute; inset: auto 0 0 0; height: 6px; background: var(--print); }
  .side {
    display: flex; align-items: center; gap: 0.5rem; padding: 0.7rem 0.75rem; min-height: 56px;
    text-decoration: none; color: var(--text-2); min-width: 0;
  }
  .side:hover { background: var(--print-wash); color: var(--print); }
  .next { justify-content: flex-end; text-align: right; }
  .side .k { font-family: var(--f-ja); font-weight: 900; font-size: 1.35rem; color: var(--print); }
  .t { display: grid; line-height: 1.15; min-width: 0; }
  .t .num { font-family: var(--f-display); font-stretch: 112%; font-weight: 750; font-size: 0.8rem; }
  .t .pl { font-size: 0.8125rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .here {
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    padding: 0.35rem 1.1rem; border-inline: 1.5px solid var(--print-line);
  }
  .here .k { font-family: var(--f-ja); font-weight: 900; font-size: 1.9rem; line-height: 1; color: var(--text); }
  .here .num {
    margin-top: 0.2rem; font-family: var(--f-display); font-stretch: 112%; font-weight: 800; font-size: 0.7rem;
    color: var(--paper); background: var(--print); border-radius: 4px; padding: 0.05rem 0.35rem;
  }
  @media (max-width: 420px) { .t .pl { display: none; } }
</style>
