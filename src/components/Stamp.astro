---
// A station stamp built from type alone: kanji in the centre, place on the upper
// rim, day and date on the lower rim. Pre-trip every stamp is a dashed outline;
// the live script inks it (data-state="stamped" | "today") as days arrive.
interface Props {
  n: number;
  kanji: string;
  place: string;
  date: string;      // "2026-12-20"
  weekday: string;   // "Sun"
  vt?: boolean;      // participate in the stamp view transition
  variant?: string;  // keeps SVG ids unique when one day's stamp appears twice on a page
  class?: string;
}
const { n, kanji, place, date, weekday, vt = false, variant = 'card', class: cls = '' } = Astro.props;
const id = `st${n}-${variant}`;
const tilt = [-7, 4, -3, 6, -9, 2, -5, 7, -2, 5, -8, 3, -4, 8, -6, 1][(n - 1) % 16];
const lower = `DAY ${String(n).padStart(2, '0')} · ${date.slice(5, 7)}.${date.slice(8, 10)} ${weekday.toUpperCase()}`;
const rimSize = place.length > 18 ? 7.4 : place.length > 13 ? 8.2 : 9;
---
<svg
  class:list={['stamp', cls]}
  viewBox="0 0 120 120"
  data-day={n}
  data-state="ahead"
  style={`--tilt:${tilt}deg;${vt ? `view-transition-name: stamp-${n};` : ''}`}
  aria-hidden="true"
>
  <defs>
    <path id={`${id}-top`} d="M 19 60 A 41 41 0 0 1 101 60" />
    <path id={`${id}-bot`} d="M 12 60 A 48 48 0 0 0 108 60" />
  </defs>
  <g class="ink">
    <circle class="wash" cx="60" cy="60" r="50" />
    <circle class="ring-outer" cx="60" cy="60" r="56.5" />
    <circle class="ring-inner" cx="60" cy="60" r="50" />
    <text class="rim" font-size={rimSize}><textPath href={`#${id}-top`} startOffset="50%" text-anchor="middle">{place}</textPath></text>
    <text class="rim rim-low" font-size="7.6"><textPath href={`#${id}-bot`} startOffset="50%" text-anchor="middle">{lower}</textPath></text>
    <text class="kanji" x="60" y="61" lang="ja" text-anchor="middle" dominant-baseline="central">{kanji}</text>
  </g>
</svg>

<style>
  .stamp {
    width: 100%; height: auto; overflow: visible;
    color: var(--print);
    transition: color 0.3s var(--ease-out), transform 0.5s var(--ease-out);
  }
  .ring-outer { fill: none; stroke: currentColor; stroke-width: 2.4; stroke-dasharray: 5.2 5.4; }
  .ring-inner { fill: none; stroke: currentColor; stroke-width: 1; opacity: 0; }
  .rim {
    fill: currentColor; font-family: var(--f-display); font-stretch: 112%; font-weight: 700;
    letter-spacing: 0.08em; opacity: 0.75;
  }
  .rim-low { letter-spacing: 0.06em; }
  .kanji { fill: currentColor; font-family: var(--f-ja); font-weight: 900; font-size: 42px; opacity: 0.85; }
  /* On small card stamps the rim lettering would be ~5px: the caption under the stamp carries it instead. */
  @media (max-width: 480px) {
    .stamp.small .rim { display: none; }
    .stamp.small .kanji { font-size: 50px; }
  }

  .stamp[data-state='stamped'], .stamp[data-state='today'] { color: var(--verm); }
  .stamp[data-state='stamped'] { transform: rotate(var(--tilt)); }
  .stamp[data-state='stamped'] .ring-outer,
  .stamp[data-state='today'] .ring-outer { stroke-dasharray: none; stroke-width: 3.6; }
  .stamp[data-state='stamped'] .ring-inner,
  .stamp[data-state='today'] .ring-inner { opacity: 1; }
  .stamp[data-state='stamped'] .rim,
  .stamp[data-state='today'] .rim,
  .stamp[data-state='stamped'] .kanji,
  .stamp[data-state='today'] .kanji { opacity: 1; }
  /* Stamped: a solid impression, a light wash inside the double ring so the kanji sits on ink. */
  .wash { fill: currentColor; opacity: 0; }
  .stamp[data-state='stamped'] .wash { opacity: 0.1; }
  .stamp[data-state='stamped'] .ring-inner { stroke-width: 1.6; }

  /* The press: a stamp lands once, the first time its day is seen as done. */
  .stamp.pressing { animation: press 0.62s var(--ease-out) both; }
  @keyframes press {
    0% { transform: rotate(calc(var(--tilt) - 10deg)) scale(1.45); opacity: 0; filter: blur(3px); }
    55% { transform: rotate(var(--tilt)) scale(0.94); opacity: 1; filter: blur(0); }
    100% { transform: rotate(var(--tilt)) scale(1); }
  }
</style>
